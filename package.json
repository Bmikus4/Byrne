{
  "name": "byrne",
  "version": "0.0.0",
  "private": true,
  "description": "A physics-diagram authoring environment: 3D construction, units and frames on every quantity, a constraint solver, and publication-quality vector output.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-site.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "byrne": "tsx src/cli/byrne.ts",
    "figures": "node scripts/render-figures.mjs",
    "gate": "python scripts/session.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "marked": "^14.1.3",
    "mathjax-full": "^3.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "kdljs": "0.3.0",
    "mathjs": "15.2.0",
    "ml-matrix": "6.15.0",
    "pdf-lib": "1.17.1",
    "three": "0.186.0"
  },
  "bin": {
    "byrne": "./src/cli/byrne.ts"
  }
}
